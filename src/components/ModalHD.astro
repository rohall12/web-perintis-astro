---
<div id="imageModal" class="modal" onclick="closeModalOnBackdrop(event)">
    <div class="modal-container">
        <button class="close-modal-btn" onclick="closeModal()" title="Tutup Preview">&times;</button>
        
        <div class="modal-image-wrapper">
            <img class="modal-content" id="modalImg" alt="Dokumen Sertifikat HD">
        </div>

        <div class="modal-actions-bar">
            <a id="modalDirectImgLink" href="#" target="_blank" class="modal-btn modal-btn-external">
                <i class="fa-solid fa-up-right-and-down-left-from-center"></i> Buka Gambar Asli (Pinch/Zoom)
            </a>
            <a id="modalVerifyLink" href="#" target="_blank" rel="noopener noreferrer" class="modal-btn modal-btn-primary">
                <i class="fa-solid fa-shield-check" style="color: #10b981;"></i> Verifikasi Platform Resmi
            </a>
        </div>
    </div>
</div>