---
import Sidebar from '../components/Sidebar.astro';
import ModalHD from '../components/ModalHD.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roni Halla — Portofolio</title>
    <meta name="description" content="Portofolio resmi Roni Halla, mahasiswa Teknik Informatika di Universitas Kristen Wira Wacana Sumba. Berfokus pada pengembangan web dan eksplorasi teknologi.">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style is:global>
        :root {
            --bg-main: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --sidebar-bg: rgba(250, 250, 250, 0.85);
            --sidebar-border: #eaeaea;
            --card-bg: rgba(255, 255, 255, 0.8);
            --card-border: #e2e8f0;
            --btn-primary-bg: #111111;
            --btn-primary-color: #ffffff;
            --btn-primary-hover: #333333;
            --form-input-bg: rgba(255, 255, 255, 0.9);
            --form-input-border: #cbd5e1;
            --form-input-text: #0f172a;
            --glow-color-1: rgba(37, 99, 235, 0.08);
            --glow-color-2: rgba(147, 51, 234, 0.07);
        }

        [data-theme="dark"] {
            --bg-main: #0b0f19;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --sidebar-bg: rgba(17, 24, 39, 0.85);
            --sidebar-border: #1f2937;
            --card-bg: rgba(17, 24, 39, 0.7);
            --card-border: #1f2937;
            --btn-primary-bg: #f8fafc;
            --btn-primary-color: #0f172a;
            --btn-primary-hover: #e2e8f0;
            --form-input-bg: rgba(17, 24, 39, 0.8);
            --form-input-border: #334155;
            --form-input-text: #f8fafc;
            --glow-color-1: rgba(37, 99, 235, 0.18);
            --glow-color-2: rgba(147, 51, 234, 0.15);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-main);
            background-color: var(--bg-main);
            margin: 0;
            padding: 0;
            position: relative;
            overflow-x: hidden;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Latar Belakang Gradasi Bergerak yang Aman & Ringan */
        body::before, body::after {
            content: '';
            position: fixed;
            width: 50vw;
            height: 50vw;
            border-radius: 50%;
            z-index: -1;
            filter: blur(80px);
            pointer-events: none;
            animation: floatGlow 12s ease-in-out infinite alternate;
        }

        body::before {
            top: -10vw;
            left: -10vw;
            background: var(--glow-color-1);
        }

        body::after {
            bottom: -10vw;
            right: -10vw;
            background: var(--glow-color-2);
            animation-delay: -6s;
        }

        @keyframes floatGlow {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(6vw, 5vh) scale(1.1); }
            100% { transform: translate(-5vw, 6vh) scale(0.95); }
        }

        .site-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            padding: 3rem 5vw;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-sizing: border-box;
        }

        .content-page { display: none; max-width: 800px; width: 100%; }
        .content-page.active { display: block; }

        .greeting-tag { 
            font-family: 'Caveat', cursive; 
            font-size: 2rem; 
            font-weight: 600; 
            color: var(--text-muted); 
            margin-bottom: 0.5rem; 
            line-height: 1.2; 
        }
        
        .highlight-name { font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 700; color: var(--text-main); letter-spacing: -1px; text-transform: none; }
        .hero-subtitle { font-size: 1.05rem; color: var(--text-muted); max-width: 700px; font-weight: 400; margin-bottom: 2rem; line-height: 1.7; }

        .btn { display: inline-flex; align-items: center; gap: 8px; padding: 0.8rem 1.6rem; border-radius: 6px; font-size: 0.9rem; font-weight: 500; text-decoration: none; transition: all 0.2s ease; }
        .btn-primary { background-color: var(--btn-primary-bg); color: var(--btn-primary-color); border: none; cursor: pointer; }
        .btn-primary:hover { background-color: var(--btn-primary-hover); transform: translateY(-1px); }

        .section-heading { font-size: 1.8rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main); letter-spacing: -1px; }
        .section-desc { font-size: 0.95rem; color: var(--text-muted); margin-bottom: 2rem; }
        
        .cert-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 24px; }
        .cert-card { background: var(--card-bg); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--card-border); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.03); transition: transform 0.25s ease, box-shadow 0.25s ease; display: flex; flex-direction: column; }
        .cert-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0,0,0,0.08); }
        .cert-img-wrapper { position: relative; width: 100%; height: 190px; background: #0f172a; cursor: pointer; overflow: hidden; }
        .cert-img-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
        .cert-card:hover .cert-img-wrapper img { transform: scale(1.05); }
        .zoom-overlay { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.65); display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 0.88rem; font-weight: 600; gap: 8px; opacity: 0; transition: opacity 0.25s ease; }
        .cert-img-wrapper:hover .zoom-overlay { opacity: 1; }
        .cert-info { padding: 18px; display: flex; flex-direction: column; flex: 1; justify-content: space-between; }
        .cert-info h4 { margin: 0 0 6px 0; font-size: 1rem; line-height: 1.4; color: var(--text-main); }
        .cert-info p { margin: 0; font-size: 0.85rem; color: var(--text-muted); }
        .btn-verify { display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; color: #2563eb; text-decoration: none; font-weight: 600; margin-top: 14px; width: fit-content; }
        .btn-verify:hover { text-decoration: underline; }

        .contact-form-container { max-width: 580px; background: var(--card-bg); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); padding: 28px; border-radius: 14px; border: 1px solid var(--card-border); box-shadow: 0 4px 16px rgba(0,0,0,0.03); margin-top: 20px; }
        .form-group { margin-bottom: 18px; display: flex; flex-direction: column; gap: 6px; text-align: left; }
        .form-group label { font-size: 0.88rem; font-weight: 600; color: var(--text-main); }
        .form-group input, .form-group textarea { width: 100%; padding: 12px 14px; background: var(--form-input-bg); color: var(--form-input-text); border: 1.5px solid var(--form-input-border); border-radius: 8px; font-family: inherit; font-size: 0.95rem; box-sizing: border-box; outline: none; transition: border-color 0.2s; }
        .form-group input:focus, .form-group textarea:focus { border-color: #2563eb; }
        .form-status { margin-top: 14px; font-size: 0.9rem; display: none; padding: 12px; border-radius: 8px; line-height: 1.4; }

        @media (max-width: 900px) {
            .site-container { flex-direction: column; }
            .main-content { padding: 2rem 1.2rem; }
        }
    </style>
</head>
<body>
    <ThemeToggle />

    <div class="site-container">
        <Sidebar />

        <main class="main-content">
            <!-- 1. HALAMAN UTAMA -->
            <section id="page-home" class="content-page active">
                <div class="hero-section">
                    <p class="greeting-tag">Selamat datang di portofolio milik ;</p>
                    <h1 class="highlight-name">Roni Halla</h1>
                    <p class="hero-subtitle" style="margin-top: 1rem;">
                        Saya merupakan seorang mahasiswa TI di Universitas Kristen Wira Wacana Sumba. Fokus saya saat ini adalah untuk merancang web ini dengan menggunakan metode framework yang ringan sehingga menjaga performa dan stabilitas web saya ketika dibuka di perangkat model lama maupun terbaru. Selain itu, saya juga ingin menampilkan sertifikat yang saya dapatkan, yang bisa dilihat langsung pada menu Sertifikat di samping. Seluruh pencapaian ini didokumentasikan sebagai bagian dari komitmen saya dalam menguasai teknologi secara bertahap dan konsisten.
                    </p>
                    <div class="action-buttons" style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
                        <button onclick="showPage('contact')" class="btn btn-primary">
                            <i class="fa-solid fa-paper-plane"></i> Hubungi Saya
                        </button>
                    </div>
                </div>
            </section>

            <!-- 2. HALAMAN SERTIFIKAT -->
            <section id="page-certificates" class="content-page">
                <div class="certificates-section">
                    <h2 class="section-heading">Sertifikat Resmi</h2>
                    <p class="section-desc">Kredensial dan pencapaian akademik yang telah diselesaikan.</p>
                    <div class="cert-grid">
                        <div class="cert-card">
                            <div class="cert-img-wrapper" onclick="openModal('/images/sertif-opswat.jpg', 'https://learn.opswatacademy.com/certificate/65FW5UseQQ')">
                                <img src="/images/sertif-opswat.jpg" alt="Sertifikat OPSWAT Academy" loading="lazy">
                                <div class="zoom-overlay"><i class="fa-solid fa-magnifying-glass-plus"></i> Perbesar Gambar</div>
                            </div>
                            <div class="cert-info">
                                <div>
                                    <h4>Introduction to Critical Infrastructure Protection</h4>
                                    <p>OPSWAT Academy (ID: 65FW5UseQQ)</p>
                                </div>
                                <a href="https://learn.opswatacademy.com/certificate/65FW5UseQQ" target="_blank" class="btn-verify" rel="noopener">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Lihat Kredensial Asli
                                </a>
                            </div>
                        </div>

                        <div class="cert-card">
                            <div class="cert-img-wrapper" onclick="openModal('/images/sertif-python.jpg', 'https://www.simplilearn.com/skillup-certificate-landing')">
                                <img src="/images/sertif-python.jpg" alt="Sertifikat Python Simplilearn" loading="lazy">
                                <div class="zoom-overlay"><i class="fa-solid fa-magnifying-glass-plus"></i> Perbesar Gambar</div>
                            </div>
                            <div class="cert-info">
                                <div>
                                    <h4>Python for Beginners</h4>
                                    <p>Simplilearn SkillUp (ID: 10671034)</p>
                                </div>
                                <a href="https://www.simplilearn.com/skillup-certificate-landing" target="_blank" class="btn-verify" rel="noopener">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Lihat Kredensial Asli
                                </a>
                            </div>
                        </div>

                        <div class="cert-card">
                            <div class="cert-img-wrapper" onclick="openModal('/images/sertif-dicoding.jpg', 'https://dicoding.com/certificates/1RXYDMN5KXVM')">
                                <img src="/images/sertif-dicoding.jpg" alt="Sertifikat Dicoding Front-End" loading="lazy">
                                <div class="zoom-overlay"><i class="fa-solid fa-magnifying-glass-plus"></i> Perbesar Gambar</div>
                            </div>
                            <div class="cert-info">
                                <div>
                                    <h4>Belajar Membuat Front-End Web untuk Pemula</h4>
                                    <p>Dicoding Indonesia (ID: 1RXYDMN5KXVM)</p>
                                </div>
                                <a href="https://dicoding.com/certificates/1RXYDMN5KXVM" target="_blank" class="btn-verify" rel="noopener">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Lihat Kredensial Asli
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. HALAMAN KONTAK -->
            <section id="page-contact" class="content-page">
                <div class="contact-section">
                    <h2 class="section-heading">Kontak</h2>
                    <p class="section-desc">Kirim pesan untuk keperluan diskusi atau kolaborasi proyek.</p>
                    <div class="contact-form-container">
                        <form id="dynamicContactForm" action="https://api.web3forms.com/submit" method="POST" onsubmit="handleContactSubmit(event)">
                            
                            <input type="hidden" name="apikey" value="MASUKKAN_ACCESS_KEY_DISINI">
                            <input type="hidden" name="subject" value="Pesan Baru dari Portofolio rohall.my.id">
                            <input type="hidden" name="from_name" value="Portofolio Roni Halla">

                            <div class="form-group">
                                <label for="senderName"><i class="fa-solid fa-user"></i> Nama / Instansi</label>
                                <input type="text" id="senderName" name="name" placeholder="Contoh: Budi" required>
                            </div>
                            <div class="form-group">
                                <label for="senderEmail"><i class="fa-solid fa-envelope"></i> Email</label>
                                <input type="email" id="senderEmail" name="email" placeholder="nama@email.com" required>
                            </div>
                            <div class="form-group">
                                <label for="senderMessage"><i class="fa-solid fa-comment-dots"></i> Pesan</label>
                                <textarea id="senderMessage" name="message" rows="4" placeholder="Tuliskan pesan Anda di sini..." required></textarea>
                            </div>

                            <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

                            <button type="submit" class="btn btn-primary" id="btnSubmitForm">
                                <i class="fa-solid fa-paper-plane"></i> Kirim Pesan
                            </button>
                            <div id="formStatus" class="form-status"></div>
                        </form>
                    </div>
                </div>
            </section>

            <footer class="site-footer" style="margin-top: 60px; padding: 24px 0; border-top: 1px solid var(--card-border); text-align: center; color: var(--text-muted); font-size: 0.9rem;">
                <p style="margin: 0;">Development By RoniHalla</p>
            </footer>
        </main>
    </div>

    <ModalHD />

    <script is:inline>
        function showPage(pageName) {
            document.querySelectorAll('.content-page').forEach(page => page.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
            const targetPage = document.getElementById('page-' + pageName);
            if (targetPage) targetPage.classList.add('active');
            const activeBtn = document.querySelector(`.nav-btn[data-page="${pageName}"]`);
            if (activeBtn) activeBtn.classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function openModal(imgSrc, verifyUrl) {
            const modal = document.getElementById("imageModal");
            const modalImg = document.getElementById("modalImg");
            const verifyLink = document.getElementById("modalVerifyLink");
            const directImgLink = document.getElementById("modalDirectImgLink");
            modal.style.display = "flex";
            modalImg.src = imgSrc;
            directImgLink.href = imgSrc;
            if (verifyUrl) {
                verifyLink.href = verifyUrl;
                verifyLink.style.display = "inline-flex";
            } else {
                verifyLink.style.display = "none";
            }
        }

        async function handleContactSubmit(event) {
            event.preventDefault();
            const form = event.target;
            const status = document.getElementById('formStatus');
            const submitBtn = document.getElementById('btnSubmitForm');

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Mengirim...';
            status.style.display = 'block';
            status.style.background = 'rgba(100,100,100,0.1)';
            status.style.color = 'var(--text-main)';
            status.innerHTML = 'Mengirim pesan ke email Dev. RoniHalla...';

            const formData = new FormData(form);

            try {
                const response = await fetch("https://api.web3forms.com/submit", {
                    method: "POST",
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    status.style.background = '#dcfce7';
                    status.style.color = '#15803d';
                    status.innerHTML = '✅ <strong>Pesan berhasil terkirim!</strong> Pesan Anda telah masuk ke email Dev. RoniHalla.';
                    form.reset();
                } else {
                    throw new Error(data.message || "Gagal mengirim pesan.");
                }
            } catch (error) {
                status.style.background = '#fee2e2';
                status.style.color = '#991b1b';
                status.innerHTML = '❌ <strong>Gagal mengirim.</strong> Pastikan Access Key sudah benar atau coba beberapa saat lagi.';
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Kirim Pesan';
            }
        }
    </script>
</body>
</html>